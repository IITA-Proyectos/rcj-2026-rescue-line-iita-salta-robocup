flowchart LR
  %% General Software Architecture - RescueBot IITA 2026
  %% Purpose: high-level ownership, data flow, interfaces and reliability guards.

  classDef offline fill:#fff7ed,stroke:#9a3412,stroke-width:2px,color:#111827;
  classDef rpi fill:#eff6ff,stroke:#1d4ed8,stroke-width:2px,color:#111827;
  classDef uart fill:#f8fafc,stroke:#334155,stroke-width:2px,color:#111827;
  classDef teensy fill:#ecfdf5,stroke:#047857,stroke-width:2px,color:#111827;
  classDef hw fill:#fef2f2,stroke:#b91c1c,stroke-width:2px,color:#111827;
  classDef evidence fill:#f5f3ff,stroke:#6d28d9,stroke-width:2px,color:#111827;

  subgraph OFFLINE["Offline training and deployment"]
    RF["Roboflow dataset<br/>6256 images / 9521 annotations<br/>classes: negro, plateado,<br/>rojo_alto, verde_alto<br/>colored walls + null examples"]:::offline
    TRAIN["Kaggle / Ultralytics training<br/>YOLOv8n, 100 epochs<br/>imgsz 256, AMP<br/>HSV, mosaic, mixup,<br/>copy-paste, erasing"]:::offline
    METRICS["Validation evidence<br/>precision 0.971<br/>recall 0.929<br/>mAP50 0.932<br/>mAP50-95 0.767"]:::offline
    EXPORT["Exported detector<br/>TFLite + embedded NMS<br/>optimized for Pi 4B CPU<br/>model path on robot:<br/>/home/iita/Documentos/best (2)_float32.tflite"]:::offline
  end

  subgraph RPI["Raspberry Pi 4B - Main.py service"]
    SERVICE["systemd starts Python service<br/>global try/except recovery<br/>safe stop on exception"]:::rpi
    INIT["Runtime initialization<br/>WebcamVideoStream src=0<br/>UART /dev/serial0 115200<br/>TFLite interpreter, 2 threads<br/>256x256 black-frame warmup"]:::rpi
    STATE["High-level state manager<br/>estado: esperando, linea,<br/>rescate, depositar,<br/>depositar verde, evacuacion"]:::rpi

    CAM["Camera frames<br/>wide-angle UVC camera<br/>line path: 160 x 120<br/>AI path: 256 x 256"]:::rpi

    LINE["Line-following vision<br/>rotate + resize frame<br/>black mask -> steering angle<br/>green LAB mask -> green_state<br/>red HSV bands -> stop codes<br/>silver mask -> rescue entry"]:::rpi

    AI_PRE["Rescue preprocessing<br/>anti_flash_preprocess<br/>V >= 215 and S <= 60<br/>highlight compression 0.45<br/>AGCWD brightness normalization"]:::rpi
    AI_INF["TFLite rescue inference<br/>DETECT_EVERY = 3<br/>thresholds: negro 45%,<br/>plateado 45%, rojo 50%,<br/>verde 60%"]:::rpi
    TRACK["Target continuity<br/>CentroidTracker max_lost=8<br/>state-based class filtering<br/>select stable target<br/>compute speed, angle, task"]:::rpi

    RPI_GUARDS["RPi reliability guards<br/>50 ms serial timeout<br/>frame-None recovery/restart<br/>headless FPS telemetry<br/>stop_teensy_safely()"]:::rpi
  end

  subgraph UART["Binary UART interface"]
    FRAME["RPi -> Teensy frame<br/>8 bytes at 115200 baud<br/>0xFF speed<br/>0xFE angle+90<br/>0xFD green_state<br/>0xFC silver_line"]:::uart
    STATUS["Teensy -> RPi status bytes<br/>0xFA boot/reset<br/>0xF9 ready<br/>0xF1 rescue request<br/>0xF8 rescue done<br/>0xF7 evacuation<br/>0xFF stop"]:::uart
  end

  subgraph TEENSY["Teensy 4.1 - main.cpp firmware"]
    T_SETUP["Setup and synchronization<br/>configure pins, motors,<br/>encoders, sensors, servos<br/>Serial5.begin(115200)<br/>send 0xFA boot notice"]:::teensy
    PARSER["serialEvent5 parser<br/>sync-byte state machine<br/>range validation for speed,<br/>angle, green_state, silver_line<br/>serial telemetry counters"]:::teensy
    LOOP["Main control loop<br/>claw.update()<br/>actualizarRescate()<br/>switch-off stop behavior<br/>robot.steer from RPi commands"]:::teensy

    LINE_ACT["Line / safety actions<br/>normal steering<br/>green marker turns<br/>red stop handling<br/>obstacle bypass<br/>APDS silver confirmation<br/>runTime, runDistance, runAngle"]:::teensy

    RESCUE_ACT["Rescue and deposit actions<br/>black and silver pickup states<br/>1 s step delay sequencing<br/>claw lower, close, lift, sort, open<br/>FCL/FCR wall alignment<br/>deposit left/right, return center"]:::teensy

    FW_GUARDS["Firmware reliability guards<br/>motion timeouts<br/>BNO/APDS visible init failure<br/>keep serial serviced during motion<br/>switch stop sends 0xFF<br/>priority_fix_flags enabled"]:::teensy
  end

  subgraph HARDWARE["Hardware controlled by firmware"]
    MOTORS["Drivebase<br/>4 DFRobot 12 V encoder motors<br/>PWM + DIR + encoder interrupts<br/>calibrated 25 counts/cm"]:::hw
    SERVOS["Rescue mechanism<br/>5 DFRobot SER0056 servos<br/>clutch protection + 5 s shutoff<br/>normal sequence uses 1-2 servos"]:::hw
    SENSORS["Sensors<br/>BNO055 yaw / ramp<br/>APDS9960 RGBC floor color<br/>HC-SR04 obstacle distance<br/>VL53L0X wall distance<br/>FCL/FCR limit switches"]:::hw
    POWER["Power and safety<br/>MP1584 servo rail measured 6.1 V<br/>XL4016 logic rail measured 5.0 V<br/>main switch, LEDs, buzzer, relay"]:::hw
  end

  subgraph EVIDENCE["Evidence and tuning loop"]
    LOGS["Service logs and TEST_LOG<br/>line FPS 91.33<br/>rescue/deposit FPS 22.25-22.40<br/>pickup 8/10, deposit 10/10<br/>runtime 1 h to 10.5 V"]:::evidence
    FIXES["Problem -> fix -> retest<br/>orange/colored walls<br/>flashlight glare<br/>AGCWD-only false positives<br/>final anti-flash + AGCWD +<br/>100-epoch model"]:::evidence
  end

  RF --> TRAIN --> METRICS --> EXPORT
  EXPORT --> INIT

  SERVICE --> INIT --> STATE
  INIT --> CAM
  CAM --> LINE
  CAM --> AI_PRE --> AI_INF --> TRACK

  STATE -->|estado = linea| LINE
  STATE -->|estado = rescate / depositar / evacuacion| AI_PRE

  LINE -->|speed angle green_state silver_line| FRAME
  TRACK -->|speed angle task class result| FRAME
  FRAME --> PARSER
  STATUS --> STATE

  T_SETUP --> PARSER --> LOOP
  LOOP --> LINE_ACT
  LOOP --> RESCUE_ACT
  LOOP --> FW_GUARDS

  PARSER -->|validated commands| LOOP
  LINE_ACT --> MOTORS
  LINE_ACT --> SENSORS
  RESCUE_ACT --> MOTORS
  RESCUE_ACT --> SERVOS
  RESCUE_ACT --> SENSORS
  FW_GUARDS --> POWER

  SENSORS -->|distance yaw color limits| LOOP
  MOTORS -->|encoder feedback| LOOP
  SERVOS -->|mechanical pickup/deposit result| LOOP

  T_SETUP --> STATUS
  LOOP --> STATUS
  FW_GUARDS --> STATUS
  RPI_GUARDS --> FRAME
  RPI_GUARDS --> LOGS
  PARSER --> LOGS
  LOOP --> LOGS
  LOGS --> FIXES
  FIXES --> RF
