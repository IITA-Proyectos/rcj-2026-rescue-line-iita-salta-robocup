flowchart TD
    subgraph TRAINING["Training pipeline"]
        A["Competition images\n(victims, walls, flashlight stress)"] --> B["Annotate in Roboflow\n4 classes: negro / plateado\nrojo_alto / verde_alto\n+ 711 null examples"]
        B --> C["YOLOv8n - 100 epochs\n256 x 256 px / AMP enabled\nhsv_s=0.7 / hsv_v=0.8 / mosaic"]
        C --> D["best.pt weights\nValidation: P=0.971 R=0.929\nmAP50=0.932"]
        D --> E["TFLite export\nnms=True embedded\nbest_float32.tflite"]
        E --> F["Deploy to Raspberry Pi 4B"]
    end

    subgraph INFERENCE["On-robot inference loop (rescue mode)"]
        G["Camera frame\n256 x 256 px detector input"] --> H["anti_flash_preprocess\nV >= 215 and S <= 60\ncompress highlights 0.45x"]
        H --> I["AGCWD normalization\nillumination correction"]
        I --> J{"Every 3 frames?"}
        J -->|"Yes"| K["TFLite interpreter\nXNNPack / ARM NEON\nabout 18 FPS"]
        J -->|"No"| L["CentroidTracker\nhold last detection"]
        K --> M["Confidence filter\n45-60% by class"]
        M --> L
        L --> N["Task byte encoding\nUART to Teensy"]
    end

    subgraph ITERATION["Iteration loop"]
        O["False positives or covered-class failures\nbecome new training samples"] --> A
    end

    F --> K
    N --> P["Teensy executes\npickup / deposit / sort"]
    K --> O
